    {
      "id": "riskScore",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Risk Score (deterministic)",
        "icon": "code"
      },
      "inputs": {
        "script": "// Deterministic risk policy - judgment lives in the agents, thresholds live here.\nconst v = $vars.validationAgent.output || {};\nconst s = $vars.screeningAgent.output || {};\nlet score = 0;\nif (s.sanctionsHit || s.debarmentHit) score += 40;\nconst blocking = (v.issues || []).filter(i => i.severity === 'blocking').length;\nscore += 15 * blocking;\nif (v.expiringWithin30Days) score += 10;\nconst mediaWeights = { low: 5, medium: 10, high: 15 };\nfor (const m of (s.adverseMedia || [])) { score += (mediaWeights[m.severity] || 5); }\nif ((v.nameVariants || []).length > 1) score += 10;\nlet tier = score < 20 ? 'low' : (score < 50 ? 'medium' : 'high');\n// Compliance override: a sanctions or debarment match can never route below high.\nif (s.sanctionsHit || s.debarmentHit) tier = 'high';\nreturn { score: score, tier: tier, blockingIssues: blocking };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "tierSwitch",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by Risk Tier",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "low",
            "label": "Low - auto-clear",
            "expression": "$vars.riskScore.output.tier === 'low'"
          },
          {
            "id": "medium",
            "label": "Medium - single approver",
            "expression": "$vars.riskScore.output.tier === 'medium'"
          },
          {
            "id": "high",
            "label": "High - parallel approval",
            "expression": "$vars.riskScore.output.tier === 'high'"
          }
        ]
      }
    },
    {
