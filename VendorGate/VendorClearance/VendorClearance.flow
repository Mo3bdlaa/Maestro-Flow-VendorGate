    },
    {
      "id": "portalGuard",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "New Portal Submission?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "$vars.pickVendor.output.found === true",
        "trueLabel": "Claimed submission",
        "falseLabel": "Nothing to process - ignore"
      }
    },
    {
      "id": "endIgnored",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Ignored (non-portal write)",
        "icon": "circle-check"
      },
      "inputs": {}
    },
    {
      "id": "buildPacket",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Assemble Packet Text",
        "icon": "code"
      },
      "inputs": {
        "script": "// Assemble the raw packet from VendorDocument rows written by the portal.\nconst trig = $vars.pickVendor.output || {};\nconst res = $vars.fetchSubmittedDocuments1.output || {};\nlet rows = res.value || res.records || res.items || (Array.isArray(res) ? res : []);\nif (!Array.isArray(rows)) rows = [];\nconst vid = trig.vendorId || trig.VendorId || '';\nconst mine = rows.filter(r => (r.vendorId || r.VendorId) === vid);\n// newest row per docType wins - resubmissions append corrected documents\nconst byType = {};\nfor (const r of mine) { const t = String(r.docType != null ? r.docType : r.DocType); byType[t] = r; }\nconst names = ['trade_licence','insurance','bank_letter','iso_cert'];\nconst sections = [];\nlet structured = [];\nfor (const key of Object.keys(byType)) {\n  const r = byType[key];\n  const ef = r.extractedFields || r.ExtractedFields || '';\n  let obj = null;\n  try { obj = typeof ef === 'string' && ef.trim() ? JSON.parse(ef) : (typeof ef === 'object' ? ef : null); } catch (e) { obj = null; }\n  const idx = Number(r.docType != null ? r.docType : r.DocType);\n  const label = names[idx] || ('doc_' + key);\n  if (obj && obj.rawText) {\n    sections.push('=== ' + label + ' ===\\n' + obj.rawText);\n  } else if (obj) {\n    structured = structured.concat(Array.isArray(obj) ? obj : [obj]);\n  } else if (typeof ef === 'string' && ef.trim()) {\n    sections.push('=== ' + label + ' ===\\n' + ef);\n  }\n}\nreturn {\n  packetText: sections.join('\\n\\n'),\n  docsJson: structured.length ? JSON.stringify(structured) : '',\n  docCount: Object.keys(byType).length\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "fetchNewVendorRow1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Fetch New Vendor Row",
        "icon": "https://cloud.uipath.com/686f994e-6d37-46c3-916d-770e0bc23c28/studio_/typecache/icons/98381fa079bbcf73264f551006d6ef7580fb53992f3d9f94361eb5d9e06040cb.svg"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "127fb909-ac85-4c93-938f-135ab0398a6c",
          "connectionResourceId": "127fb909-ac85-4c93-938f-135ab0398a6c",
          "connectionFolderKey": "cd671762-f695-48f8-ac4b-f849efe70464",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "queryParameters": {
            "limit": 1000,
            "expansionLevel": 1
          },
          "pathParameters": {
            "entityName": "Vendor"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the connector.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
