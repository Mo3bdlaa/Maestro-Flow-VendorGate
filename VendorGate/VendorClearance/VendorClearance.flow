    {
      "id": "pickVendor",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Claim Newest Submission",
        "icon": "code"
      },
      "inputs": {
        "script": "// The trigger only signals 'a Vendor row was created'. Claim the newest\n// unprocessed portal submission; races self-heal because each instance\n// claims one row and immediately moves it out of status 0.\nconst res = $vars.fetchNewVendorRow1.output || {};\nlet rows = res.value || res.records || res.items || (Array.isArray(res) ? res : []);\nif (!Array.isArray(rows)) rows = [];\nconst get = (r, a, b) => r[a] != null ? r[a] : r[b];\nconst cands = rows.filter(r => Number(get(r,'status','Status')) === 0 && (get(r,'contactEmail','ContactEmail') || '').length > 0);\ncands.sort((a, b) => String(get(a,'CreateTime','createTime') || '').localeCompare(String(get(b,'CreateTime','createTime') || '')));\nconst v = cands.length ? cands[cands.length - 1] : null;\nif (!v) return { found: false };\nreturn {\n  found: true,\n  Id: get(v,'Id','id'),\n  vendorId: get(v,'vendorId','VendorId'),\n  legalName: get(v,'legalName','LegalName'),\n  country: get(v,'country','Country'),\n  contactEmail: get(v,'contactEmail','ContactEmail'),\n  status: Number(get(v,'status','Status'))\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    }
  ],
