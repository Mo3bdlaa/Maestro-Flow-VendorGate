:\"integer\"}}},\"UpdatedBy\":{\"type\":\"object\",\"properties\":{\"UpdateTime\":{\"title\":\"Updated by update time\",\"type\":\"string\"},\"Name\":{\"title\":\"Updated by name\",\"type\":\"string\"},\"Id\":{\"title\":\"Updated by ID\",\"type\":\"string\"},\"CreateTime\":{\"title\":\"Updated by create time\",\"type\":\"string\"},\"IsActive\":{\"title\":\"Updated by is active\",\"type\":\"boolean\"},\"Type\":{\"title\":\"Updated by type\",\"type\":\"integer\"},\"Email\":{\"title\":\"Updated by email\",\"type\":\"string\"}}},\"CreatedBy\":{\"type\":\"object\",\"properties\":{\"Type\":{\"title\":\"Created by type\",\"type\":\"integer\"},\"UpdateTime\":{\"title\":\"Created by update time\",\"type\":\"string\"},\"Id\":{\"title\":\"Created by ID\",\"type\":\"string\"},\"Name\":{\"title\":\"Created by name\",\"type\":\"string\"},\"Email\":{\"title\":\"Created by email\",\"type\":\"string\"},\"CreateTime\":{\"title\":\"Created by create time\",\"type\":\"string\"},\"IsActive\":{\"title\":\"Created by is active\",\"type\":\"boolean\"}}}},\"items\":{\"$ref\":\"#/definitions/root\"}},\"hasFileOutput\":false,\"populateOutputFields\":true,\"inputFields\":[{\"typeScriptDefinition\":null,\"useUrlInput\":false,\"id\":\"entityName\",\"name\":\"entityName\",\"displayName\":\"Entity\",\"description\":\"Enter entity name\",\"type\":\"string\",\"sortOrder\":1,\"primaryKey\":false,\"lookup\":{\"objectName\":\"system\",\"lookupNames\":[\"displayName\"],\"lookupValue\":\"name\",\"path\":\"/standard-objects\"},\"design\":{\"loadByDefault\":true,\"isMultiSelect\":false,\"enableUserOverride\":false,\"isHidden\":false,\"position\":\"primary\",\"validation\":false},\"fieldActions\":[],\"searchable\":false,\"searchableOperators\":null,\"searchableNames\":null,\"searchableJoins\":[\"AND\",\"OR\"],\"required\":true,\"request\":true,\"response\":false,\"responseCurated\":false,\"fieldLocation\":\"path\",\"onCanvas\":null,\"isJitField\":false,\"isFieldActionParent\":false,\"isMainResponseField\":f